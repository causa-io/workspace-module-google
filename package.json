{
  "name": "@causa/workspace-google",
  "version": "1.3.1",
  "description": "The Causa workspace module providing many functionalities related to GCP and its services.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causa-io/workspace-module-google.git"
  },
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./services": "./dist/services/index.js"
  },
  "files": [
    "dist/",
    "LICENSE.md",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "copyfiles -u 1 src/**/assets/**/* dist/ && node transform-schemas.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings=ExperimentalWarning\" jest",
    "test:cov": "npm run test -- --coverage",
    "typecheck": "tsc --noEmit",
    "generateConfigurationSchemas": "cs model genCode && perl -pi -e 's|\\@causa/runtime|\\@causa/workspace/validation|g' src/configurations/generated.ts"
  },
  "dependencies": {
    "@causa/cli": "^1.0.0",
    "@causa/workspace": "^1.0.2",
    "@causa/workspace-core": "^1.3.0",
    "@causa/workspace-typescript": "^1.3.0",
    "@google-cloud/apikeys": "^2.2.2",
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/iam-credentials": "^4.2.2",
    "@google-cloud/logging": "^11.3.0",
    "@google-cloud/monitoring": "^5.4.0",
    "@google-cloud/pubsub": "^5.3.1",
    "@google-cloud/resource-manager": "^6.3.0",
    "@google-cloud/run": "^3.3.0",
    "@google-cloud/secret-manager": "^6.3.0",
    "@google-cloud/service-usage": "^4.2.2",
    "@google-cloud/spanner": "^8.10.0",
    "@google-cloud/storage": "^7.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "globby": "^16.2.2",
    "google-gax": "5.0.6",
    "googleapis": "^173.0.0",
    "micromatch": "^4.0.8",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node22": "^22.0.5",
    "@types/jest": "^30.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.20.1",
    "copyfiles": "^2.4.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "yaml": "^2.9.0"
  }
}
